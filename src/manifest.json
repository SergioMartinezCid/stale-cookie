{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "homepage_url": "https://github.com/SergioMartinezCid/stale-cookie",
  "permissions": ["cookies", "history", "storage", "contextualIdentities", "alarms"],
  "optional_permissions": ["downloads", "browsingData", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background/index.js"]
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stale-cookie@sergiomartinezcid.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
