{
  "name": "stale-cookie",
  "version": "1.0.0",
  "description": "Browser extension that clears stale browser data from sites you no longer visit.",
  "license": "MIT",
  "author": "Sergio Martínez Cid",
  "homepage": "https://github.com/SergioMartinezCid/stale-cookie#readme",
  "bugs": "https://github.com/SergioMartinezCid/stale-cookie/issues",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/build.mjs && vitest run --config vitest.integration.config.ts",
    "screenshots": "node scripts/build.mjs && vitest run --config vitest.screenshots.config.ts",
    "build:icons": "mkdir -p src/icons && for s in 16 32 48 96 128; do convert -background none -density 768 assets/icon.svg -resize ${s}x${s} src/icons/icon-$s.png; done",
    "start:firefox": "web-ext run --source-dir dist",
    "lint:ext": "web-ext lint --source-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergioMartinezCid/stale-cookie.git"
  },
  "dependencies": {
    "tldts": "^7.4.10",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/selenium-webdriver": "^4.35.6",
    "@types/webextension-polyfill": "^0.12.5",
    "esbuild": "^0.28.1",
    "selenium-webdriver": "^4.46.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "web-ext": "^10.6.0"
  }
}
